---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import MobileTableOfContents from '../../components/MobileTableOfContents.astro';
import BackToTop from '../../components/BackToTop.astro';
import songCatalogFonts from '../../styles/song-catalog-fonts.css?url';

export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    (entry) => import.meta.env.DEV || !entry.data.draft,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const isSongCatalog = post.id === 'bangdream-cover-song-list';
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  {isSongCatalog && <link rel="stylesheet" href={songCatalogFonts} />}
  <TableOfContents headings={headings} />
  <article class="post-article">
    <MobileTableOfContents headings={headings} />
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <PostMeta
        pubDate={post.data.pubDate}
        updatedDate={post.data.updatedDate}
        tags={post.data.tags}
      />
    </header>

    <div class:list={['post-content', { 'song-catalog-content': isSongCatalog }]}>
      <Content />
    </div>

    <footer class="post-footer">
      <p><a href="/blog/">← 返回博客列表</a></p>
    </footer>
  </article>

  <!-- 预留 giscus 评论容器 -->
  <div id="comments" class="comments-container"></div>
  <BackToTop />
</BlogLayout>

<script>
  const codeBlocks = document.querySelectorAll<HTMLElement>(
    '.post-content pre.astro-code',
  );

  for (const block of codeBlocks) {
    if (block.parentElement?.classList.contains('code-block')) continue;

    const code = block.querySelector('code');
    if (!code) continue;

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';

    const copyButton = document.createElement('button');
    copyButton.type = 'button';
    copyButton.className = 'code-copy-button';
    copyButton.textContent = '复制';
    copyButton.setAttribute('aria-label', '复制代码');

    let resetTimer: number | undefined;
    copyButton.addEventListener('click', async () => {
      window.clearTimeout(resetTimer);

      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        copyButton.textContent = '已复制';
        copyButton.setAttribute('aria-label', '代码已复制');
        copyButton.classList.add('is-copied');
      } catch {
        copyButton.textContent = '复制失败';
        copyButton.setAttribute('aria-label', '复制失败');
      }

      resetTimer = window.setTimeout(() => {
        copyButton.textContent = '复制';
        copyButton.setAttribute('aria-label', '复制代码');
        copyButton.classList.remove('is-copied');
      }, 2000);
    });

    block.before(wrapper);
    wrapper.append(block, copyButton);
  }
</script>

<style>
  .post-header {
    margin-bottom: var(--space-xl);
  }

  .post-content {
    margin-bottom: var(--space-2xl);
  }

  .post-content :global(blockquote) {
    margin: var(--space-lg) 0;
    padding: var(--space-md) var(--space-lg);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--color-text-secondary);
    background-color: var(--color-surface);
  }

  .post-content :global(blockquote > :first-child) {
    margin-top: 0;
  }

  .post-content :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .post-content :global(pre.astro-code) {
    margin: 0;
    padding: var(--space-lg);
    padding-right: 5.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface) !important;
    box-shadow: 0 1px 2px rgb(0 0 0 / 4%);
    line-height: 1.6;
  }

  .post-content :global(pre.astro-code code) {
    padding: 0;
    background-color: transparent;
  }

  .post-content :global(img) {
    display: block;
    /* Keep Astro's width/height attributes so lazy images reserve space. */
    max-width: 92%;
    margin: var(--space-xl) auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    box-shadow: 0 2px 8px rgb(0 0 0 / 6%);
  }

  .post-content :global(figure) {
    margin: var(--space-xl) 0;
  }

  .post-content :global(figure img) {
    margin: 0 auto;
  }

  .post-content :global(figcaption) {
    max-width: 92%;
    margin: var(--space-sm) auto 0;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: center;
  }

  .post-footer {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .comments-container {
    margin-top: var(--space-2xl);
  }

  @media (max-width: 639px) {
    .post-content :global(img) {
      max-width: 96%;
      margin: var(--space-lg) auto;
    }

    .post-content :global(figure) {
      margin: var(--space-lg) 0;
    }

    .post-content :global(figure img) {
      margin: 0 auto;
    }

    .post-content :global(figcaption) {
      max-width: 96%;
    }
  }
</style>

<style is:global>
  .song-catalog-content {
    font-family: 'Catalog Sans SC', 'Noto Sans SC', 'PingFang SC',
      'Microsoft YaHei', sans-serif;
  }

  .song-catalog-content :lang(ja) {
    font-family: 'Catalog Sans JP', 'Noto Sans JP', 'Hiragino Sans',
      'Yu Gothic', 'Meiryo', sans-serif;
  }

  .post-content .song-table-scroll {
    max-width: 100%;
    overflow-x: auto;
    margin: var(--space-lg) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .post-content .song-table-scroll:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .post-content .song-table-scroll table {
    width: 100%;
    min-width: 90rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .post-content .song-table-scroll th,
  .post-content .song-table-scroll td {
    padding: 0.65rem 0.8rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .post-content .song-table-scroll th {
    background-color: var(--color-surface);
    white-space: nowrap;
  }

  .post-content .song-table-scroll td:first-child,
  .post-content .song-table-scroll td:nth-child(2),
  .post-content .song-table-scroll td:nth-child(4),
  .post-content .song-table-scroll td:nth-child(8) {
    font-variant-numeric: tabular-nums;
  }

  .post-content .song-table-scroll td:nth-child(2),
  .post-content .song-table-scroll td:nth-child(8),
  .post-content .song-table-scroll td:nth-child(9),
  .post-content .song-table-scroll td:nth-child(10) {
    white-space: nowrap;
  }

  .post-content .song-table-scroll tbody tr:last-child td {
    border-bottom: 0;
  }

  .post-content .code-block {
    position: relative;
    margin: var(--space-lg) 0;
  }

  .post-content .code-copy-button {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    background-color: var(--color-bg);
    font: inherit;
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .post-content .code-copy-button:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .post-content .code-copy-button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .post-content .code-copy-button.is-copied {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: #eff6ff;
  }

  @media (hover: hover) and (pointer: fine) {
    .post-content .code-copy-button {
      opacity: 0;
      transform: translateY(-2px);
      pointer-events: none;
    }

    .post-content .code-block:hover .code-copy-button,
    .post-content .code-block:focus-within .code-copy-button {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }
</style>
